# Серверный блок для obsidian.boostix.space.
#
# Кладётся в /etc/nginx/sites-available/obsidian.boostix.space и линкуется в
# sites-enabled. TLS-часть дописывает certbot:
#
#   certbot --nginx -d obsidian.boostix.space
#
# Автопродление обеспечивает системный таймер certbot.timer, отдельный cron не нужен.

upstream vaultwire_server {
    server 127.0.0.1:8787;
    keepalive 16;
}

# Соединение апгрейдится только когда клиент этого просит, иначе закрывается.
# Без этой карты WebSocket молча деградирует в обычный запрос.
map $http_upgrade $vaultwire_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name obsidian.boostix.space;

    # Проверка ACME должна идти по HTTP, поэтому редирект стоит после неё.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Синтаксис для nginx 1.24 и старше. На 1.25+ это даёт предупреждение об
    # устаревании, там правильнее отдельная директива http2 on.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name obsidian.boostix.space;

    ssl_certificate /etc/letsencrypt/live/obsidian.boostix.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/obsidian.boostix.space/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Заголовки CORS не нужны: плагин ходит через requestUrl из API Obsidian,
    # который не подчиняется политике источника. Браузерных клиентов у сервиса нет.

    # Предел шифротела плюс запас на служебную обвязку. Должен быть не меньше
    # MAX_BLOB_BYTES из .env, иначе вложения будут отваливаться загадочным 413.
    client_max_body_size 64M;

    # Тело блоба идёт одним потоком и в буферизации не нуждается.
    proxy_request_buffering off;

    location /v1/sync {
        proxy_pass http://vaultwire_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vaultwire_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # Канал живёт долго и молчит между изменениями: без длинного таймаута
        # nginx рвёт его каждую минуту, и клиент бесконечно переподключается.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://vaultwire_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://vaultwire_server;
        access_log off;
    }
}
