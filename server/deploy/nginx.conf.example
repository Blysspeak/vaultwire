# Пример серверного блока для obsidian.boostix.space.
# Копируется в /etc/nginx/sites-available/obsidian.boostix.space и линкуется в sites-enabled.
# Сертификат выпускается до включения 443-блока, иначе nginx не стартует (см. deploy/README.md).

upstream vaultwire_app {
    # Приложение слушает только петлю, наружу смотрит исключительно nginx.
    server 127.0.0.1:8787;
    keepalive 16;
}

# Значение Connection для апстрима: upgrade при рукопожатии WebSocket, close в обычных запросах.
# Хардкод 'upgrade' на всех location рвёт keepalive обычных запросов.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name obsidian.boostix.space;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name obsidian.boostix.space;

    ssl_certificate     /etc/letsencrypt/live/obsidian.boostix.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/obsidian.boostix.space/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Не меньше MAX_BLOB_BYTES из .env (50 МБ) плюс запас на заголовки и служебный
    # оверхед. Меньше — и nginx вернёт свой 413 раньше приложения, клиент увидит
    # HTML вместо тела ProtocolError и не поймёт, какой файл пропускать.
    client_max_body_size 64m;
    client_body_timeout 300s;

    # CORS не нужен: плагин ходит через requestUrl из API Obsidian, он вне модели origin.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /v1/sync {
        proxy_pass http://vaultwire_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Соединение простаивает между изменениями. Штатные 60 секунд рвали бы его
        # постоянно; heartbeat раз в 30 секунд держит канал живым внутри этого окна.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Звоночек должен уходить клиенту сразу, а не копиться в буфере nginx.
        proxy_buffering off;
    }

    location = /health {
        proxy_pass http://vaultwire_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Мониторинг не должен засорять журнал доступа.
        access_log off;
    }

    # Заливка шифротел идёт сюда. Буферизацию запроса оставляем включённой:
    # nginx примет медленного клиента во временный файл, а не займёт процесс Node.
    location / {
        proxy_pass http://vaultwire_app;
        proxy_http_version 1.1;
        # Пустой Connection обязателен для keepalive до апстрима.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
