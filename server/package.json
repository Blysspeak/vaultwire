{
  "name": "@vaultwire/server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер синхронизации vaultwire: Fastify, Prisma, PostgreSQL",
  "type": "module",
  "imports": {
    "#app": "./src/app.ts",
    "#config": "./src/config.ts",
    "#logger": "./src/logger.ts",
    "#db": "./src/db.ts",
    "#protocol-error": "./src/protocol-error.ts",
    "#plugins/*": "./src/plugins/*.ts",
    "#routes/*": "./src/routes/*.ts",
    "#services/*": "./src/services/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^6.19.2",
    "@vaultwire/shared": "file:../shared",
    "fastify": "^5.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "ulid": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "^6.19.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
