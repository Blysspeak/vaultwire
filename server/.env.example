# Строка подключения к отдельной базе vaultwire, не к базе boostix
DATABASE_URL=postgresql://vaultwire:password@127.0.0.1:5432/vaultwire

# Адрес прослушивания, наружу смотрит nginx
PORT=8787
HOST=127.0.0.1

# Каталог шифротел, раскладка blobs/<spaceId>/<хеш[0:2]>/<хеш>
BLOB_DIR=./data/blobs

# Токен создания пространств. Пусто — POST /v1/spaces отключён
BOOTSTRAP_TOKEN=

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Предел одного шифротела, байты (50 МБ)
MAX_BLOB_BYTES=52428800

# Квота пространства по умолчанию, байты (5 ГБ)
DEFAULT_QUOTA_BYTES=5368709120

# Период сборки мусора, миллисекунды (1 час). 0 — отключить
GC_INTERVAL_MS=3600000
